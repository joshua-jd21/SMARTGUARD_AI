# SmartGuard AI — Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ─── Required ────────────────────────────────────────────────
# Google Gemini API key (also accepted as GEMINI_API_KEY)
GOOGLE_API_KEY=your-gemini-api-key-here

# ─── Optional (enables live web research) ────────────────────
# SerpAPI key — fallback mode works without it
SERPAPI_API_KEY=your-serpapi-key-here

# ─── MQTT Broker (defaults work out of the box) ──────────────
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TOPIC=smartguard/patient/vitals

# ─── Patient (optional overrides) ────────────────────────────
# PATIENT_ID=PATIENT_001
# PATIENT_NAME=Rajan
# PATIENT_AGE=45

# ─── LLM Tuning (optional overrides) ─────────────────────────
# GEMINI_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.3
